# ── apps/web (.env.local) ────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
AUTH_SECRET=change_this_to_random_32_chars_string

# OAuth (선택)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── apps/api (.env) ──────────────────
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# PostgreSQL (Docker 자동 세팅)
DATABASE_URL=postgresql://welfare:welfare_pass@localhost:5432/welfare_ai

# Neo4j (Docker 자동 세팅)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=welfare_neo4j_pass

# Qdrant (Docker 자동 세팅)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=welfare_policies

# Redis (Docker 자동 세팅)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=welfare_redis_pass

# JWT (반드시 변경)
JWT_SECRET=change_this_jwt_secret_64_chars_minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# !! 필수: OpenAI (RAG 파이프라인 핵심)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini

# LangSmith (LangGraph/LangChain/Neo4j 추론 추적)
# 발급: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=welfare-ai-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 선택: Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 공공 API (data.go.kr 발급)
PUBLIC_DATA_API_KEY=
BOKJIRO_API_KEY=
SEOUL_OPEN_API_KEY=
GYEONGGI_API_KEY=
YOUTH_CENTER_API_KEY=

# 선택: Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# 선택: Resend (이메일)
RESEND_API_KEY=

# 선택: AWS S3
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=welfare-ai-documents
