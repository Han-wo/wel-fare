# ─────────────────────────────────────────────────────────────────────────────
# Build context: monorepo root  (docker build -f apps/web/Dockerfile .)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: base image ───────────────────────────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate

# ── Stage 2: pre-fetch external packages (cache by lockfile) ──────────────────
FROM base AS fetch
WORKDIR /repo
COPY pnpm-lock.yaml ./
RUN pnpm fetch

# ── Stage 3: install all deps ─────────────────────────────────────────────────
FROM fetch AS installer
COPY . .
RUN pnpm install --frozen-lockfile --offline

# ── Stage 4: build Next.js ────────────────────────────────────────────────────
FROM installer AS builder
ENV NEXT_TELEMETRY_DISABLED=1

# Pass public env vars available at build time as build args
# (runtime-only vars like API_URL are set via docker-compose env)
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @welfare-ai/web exec next build

# ── Stage 5: production runner ────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nextjs

# Static files (served by Next.js standalone server)
COPY --from=builder /repo/apps/web/public ./public

# Standalone server bundle (includes server.js + trimmed node_modules)
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./

# Static assets generated by Next.js
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# next.config.ts output:'standalone' generates server.js at the app root
CMD ["node", "apps/web/server.js"]
