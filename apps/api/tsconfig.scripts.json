{
  // ts-node로 직접 실행하는 dev 스크립트(시드/마이그레이션/eval)용 설정.
  // 프로덕션 빌드(tsconfig.build.json → tsconfig.json)는 paths가 비어 있어야
  // dist emit 구조가 안 깨지므로, 워크스페이스 패키지 경로 매핑은 여기에만 둔다.
  // dist 빌드 없이도 @welfare-ai/* 를 소스에서 바로 해소한다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@welfare-ai/shared-types": ["../../packages/shared-types/src"],
      "@welfare-ai/shared-utils": ["../../packages/shared-utils/src"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "require": ["tsconfig-paths/register"]
  }
}
