{
  "name": "@welfare-ai/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "typeorm migration:run -d src/database/data-source.ts",
    "db:migrate:create": "typeorm migration:create src/database/migrations/migration",
    "db:migrate:revert": "typeorm migration:revert -d src/database/data-source.ts",
    "db:seed": "ts-node -r dotenv/config src/database/seeds/run-seeds.ts",
    "db:seed:neo4j": "ts-node -r dotenv/config src/database/seeds/neo4j.seed.ts",
    "db:seed:qdrant": "ts-node -r dotenv/config src/database/seeds/qdrant.seed.ts",
    "db:seed:welfare": "ts-node -r dotenv/config --transpile-only src/database/seeds/welfare-api.seed.ts",
    "db:seed:local-welfare": "ts-node -r dotenv/config --transpile-only src/database/seeds/local-welfare.seed.ts",
    "db:seed:housing": "ts-node -r dotenv/config --transpile-only src/database/seeds/rental-housing.seed.ts",
    "db:seed:facility": "ts-node -r dotenv/config --transpile-only src/database/seeds/welfare-facility.seed.ts",
    "db:seed:housing-anno": "ts-node -r dotenv/config --transpile-only src/database/seeds/housing-announcement.seed.ts",
    "db:seed:admin": "ts-node -r dotenv/config --transpile-only src/database/seeds/admin.seed.ts",
    "db:seed:applyhome": "ts-node -r dotenv/config --transpile-only src/database/seeds/applyhome.seed.ts",
    "db:seed:applyhome-cmpet": "ts-node -r dotenv/config --transpile-only src/database/seeds/applyhome-cmpet.seed.ts",
    "db:seed:applyhome-stat": "ts-node -r dotenv/config --transpile-only src/database/seeds/applyhome-stat.seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@nestjs/bullmq": "^10.0.0",
    "@nestjs/cache-manager": "^2.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@qdrant/js-client-rest": "^1.0.0",
    "@welfare-ai/ontology-schema": "workspace:*",
    "@welfare-ai/shared-types": "workspace:*",
    "@welfare-ai/shared-utils": "workspace:*",
    "axios": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cache-manager": "^5.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dayjs": "^1.0.0",
    "fastify": "^5.0.0",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "langchain": "^0.3.0",
    "langsmith": "^0.2.0",
    "lodash": "^4.17.21",
    "neo4j-driver": "^5.0.0",
    "ofetch": "^1.0.0",
    "openai": "^4.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "passport-kakao": "^1.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^3.0.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0",
    "uuid": "^10.0.0",
    "xml2js": "^0.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/lodash": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/xml2js": "^0.4.0",
    "@welfare-ai/eslint-config": "workspace:*",
    "jest": "^29.0.0",
    "supertest": "^6.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0"
  }
}
