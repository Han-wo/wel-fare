# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=welfare_ai
POSTGRES_USER=welfare
POSTGRES_PASSWORD=change_me_strong_password

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=change_me_neo4j_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change_me_nextauth_secret_min_32_chars

# ─── URLs ─────────────────────────────────────────────────────────────────────
WEB_URL=https://your-domain.com
API_PUBLIC_URL=https://api.your-domain.com

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QDRANT_VECTOR_SIZE=1536

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── LangSmith (optional, set LANGCHAIN_TRACING_V2=true to enable) ─────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=welfare-ai-rag

# ─── Firebase (push notifications, optional) ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Resend (email, optional) ─────────────────────────────────────────────────
RESEND_API_KEY=

# ─── AWS S3 (file upload, optional) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=

# ─── Public Welfare API ───────────────────────────────────────────────────────
PUBLIC_DATA_API_KEY=
BOKJIRO_API_KEY=
YOUTH_CENTER_API_KEY=

# ── 2026-07 추가 (배포 가이드 docs/deployment-oracle.md 참고) ──────────────
# Caddy TLS 도메인 (예: welfare-api.duckdns.org)
DOMAIN=
# 공공데이터 추가 키
SEOUL_OPEN_API_KEY=
GYEONGGI_API_KEY=
# 관리자 시드 계정 (db:seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 라우팅 LLM 폴백 (off로 비활성화 가능)
OPENAI_ROUTER_MODEL=gpt-5-nano
RAG_ROUTE_LLM_FALLBACK=on

# ── 2026-10 추가 ──────────────────────────────────────────────────────────────
# 보조금24 전용 키. 공공데이터포털은 데이터셋별로 활용신청을 따로 받으므로
# PUBLIC_DATA_API_KEY와 별개다(미설정 시 gov24 시드가 -401로 실패).
# https://www.data.go.kr/data/15113968/openapi.do
GOV24_API_KEY=

# ── RAG 튜닝 (전부 선택 — 비우면 코드 기본값) ─────────────────────────────────
# 답변 TTFB의 지배적 요인은 reasoning 토큰이다. 측정값(gpt-5-mini, 동일 프롬프트):
#   기본 9.45s / low 2.10s / minimal 1.00s
# 기본값: agent=low(도구 선택 정확도 유지), answer=minimal(근거 옮겨쓰기)
RAG_AGENT_REASONING_EFFORT=
RAG_ANSWER_REASONING_EFFORT=
# 하이브리드 검색(dense+sparse RRF). off로 dense 단독 폴백
RAG_HYBRID_SEARCH=
# LLM 리랭커 (off로 비활성화 — 융합 순위 그대로 사용)
RAG_RERANK_ENABLED=
RAG_RERANK_MODEL=
RAG_RERANK_TIMEOUT_MS=
# 후속질문 재작성기
RAG_CONDENSE_MODEL=
RAG_CONDENSE_TIMEOUT_MS=
# 라우팅 LLM 폴백 타임아웃
RAG_ROUTE_FALLBACK_TIMEOUT_MS=
